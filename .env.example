# Copy to .env (local dev) and fill in. Never commit real values.

# --- Database (PostgreSQL) ---
# Use the direct (non-pooled) connection string: `prisma migrate deploy`
# needs a session-mode connection, not a transaction-mode pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# --- Public URL ---
# Absolute origin used in emails, SMS, quote links and the embed snippet.
# No trailing slash. Locally: http://localhost:3000
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# --- Demo protection (HTTP basic auth) ---
# Leave either one blank to turn protection off (e.g. local dev).
DEMO_USER=""
DEMO_PASSWORD=""

# --- Scheduled jobs ---
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" to
# /api/cron/*. Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- Email (Resend) ---
RESEND_API_KEY=""

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# --- AI follow-ups (Anthropic) ---
ANTHROPIC_API_KEY=""
